# --- Origins -----------------------------------------------------------------
# Dashboard, API and /p/:slug. In dev this is the Vite server, which proxies to the API.
APP_URL=http://localhost:5180
# Raw uploaded HTML only. Must be a different origin from APP_URL.
USERCONTENT_URL=http://127.0.0.1:8000

PORT=8000
# Number of reverse proxies in front of the app (Traefik on Dokploy = 1).
TRUST_PROXY=0

# --- Database & files ---------------------------------------------------------
# docker compose up -d postgres
DATABASE_URL=postgres://vellum:vellum@localhost:5433/vellum
# Tests use TEST_DATABASE_URL (default postgres://localhost:5432/vellum_test).
TEST_DATABASE_URL=postgres://vellum:vellum@localhost:5433/vellum_test
DATA_DIR=./data
MAX_UPLOAD_MB=20
# Limits for .zip uploads, after unpacking.
MAX_UNZIPPED_MB=100
MAX_ZIP_FILES=1000
# Each invited user's limits, unless an admin sets their own. Admins have none.
USER_MAX_DOCUMENTS=50
USER_MAX_STORAGE_MB=500

# --- First admin (created on first boot only; `pnpm --filter @vellum/api owner:reset` to get back in) ---
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-please
OWNER_NAME=Amirali

# --- Secrets: generate each with `openssl rand -base64 48` ---------------------
# Signs reader unlock cookies and usercontent tokens.
SIGNING_SECRET=
# Encrypts document passwords so their author can see them again (AES-256-GCM).
ENCRYPTION_KEY=
