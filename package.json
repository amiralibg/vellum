{
  "name": "vellum",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @vellum/api --filter @vellum/web dev",
    "build": "pnpm --filter @vellum/web build && pnpm --filter @vellum/api build",
    "test": "pnpm --filter @vellum/api test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
