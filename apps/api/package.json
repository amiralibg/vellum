{
  "name": "@vellum/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,css \"tsx watch --env-file-if-exists=../../.env src/server.ts\" \"pnpm css --watch\"",
    "css": "tailwindcss -i src/reader/reader.css -o public/reader/reader.css --minify",
    "build": "pnpm css && tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p .",
    "owner:reset": "tsx --env-file-if-exists=../../.env src/scripts/owner-reset.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@vellum/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-string": "^3.0.1",
    "helmet": "^8.3.0",
    "mdast-util-to-string": "^4.0.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5",
    "yazl": "^3.3.1"
  }
}
